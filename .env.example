# Copy to .env and fill in. Never commit .env.

# Project URL, like https://abcdefgh.supabase.co
SUPABASE_URL=

# The part of the URL before .supabase.co (abcdefgh above)
SUPABASE_PROJECT_REF=

# Publishable key (sb_publishable_...), or the legacy anon key. Safe to ship in the extension: RLS protects the data.
SUPABASE_PUBLISHABLE_KEY=

# SECRET. Secret key (sb_secret_...), or the legacy service_role key. It bypasses RLS: development and tests only, never in the extension or MCP server.
SUPABASE_SECRET_KEY=

# SECRET. The database password you set when creating the project. Used to run migrations.
SUPABASE_DB_PASSWORD=
