{
  "name": "hacky",
  "displayName": "Hacky",
  "description": "A shared brain for your team's AI coding agents.",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "publisher": "hacky",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hacky",
          "title": "Hacky",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "hacky": [
        {
          "type": "webview",
          "id": "hacky.sidebar",
          "name": "Team"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit && node --env-file=../../.env esbuild.mjs",
    "test": "npm run build && tsc --outDir out --noEmit false && node --env-file=../../.env --test \"out/**/*.test.js\"",
    "test:host": "npm run build && node test-host/run.mjs",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "hacky-mcp-server": "*"
  },
  "devDependencies": {
    "@types/jsdom": "^21.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.0.0"
  }
}
