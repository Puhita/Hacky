{
  "name": "hacky",
  "displayName": "Hacky",
  "description": "A shared brain for your team's AI coding agents.",
  "version": "0.1.0",
  "license": "MIT",
  "icon": "media/icon.png",
  "publisher": "ko-solutions",
  "repository": {
    "type": "git",
    "url": "https://github.com/Puhita/Hacky.git",
    "directory": "packages/extension"
  },
  "homepage": "https://github.com/Puhita/Hacky#readme",
  "bugs": "https://github.com/Puhita/Hacky/issues",
  "keywords": ["claude code", "ai agents", "team", "hackathon", "mcp", "task board"],
  "galleryBanner": {
    "color": "#16132B",
    "theme": "dark"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "hacky.openMap",
        "title": "Hacky: Open Map"
      },
      {
        "command": "hacky.openBoard",
        "title": "Hacky: Open Board"
      },
      {
        "command": "hacky.openSkills",
        "title": "Hacky: Open Skills"
      },
      {
        "command": "hacky.openGit",
        "title": "Hacky: Open Git"
      }
    ],
    "configuration": {
      "title": "Hacky",
      "properties": {
        "hacky.progressDigestMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "How often, in minutes, to show what your teammates' agents have got done. 0 turns it off."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hacky",
          "title": "Hacky",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "hacky": [
        {
          "type": "webview",
          "id": "hacky.sidebar",
          "name": "Team"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit && node --env-file=../../.env esbuild.mjs",
    "test": "npm run build && tsc --outDir out --noEmit false && node --env-file=../../.env --test \"out/**/*.test.js\"",
    "test:host": "npm run build && node test-host/run.mjs",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "hacky-mcp-server": "*"
  },
  "devDependencies": {
    "@types/jsdom": "^21.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.0.0"
  }
}
